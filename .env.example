# このファイルをコピーして .env を作成する。.env はコミットしない（CLAUDE.md §13）
# EAS でビルドするときは、同じ名前で EAS の環境変数に設定する（docs/operations.md）

# Supabase の接続先
# ローカル開発: `npx supabase start` の出力にある API_URL と ANON_KEY を貼る
# 実機から接続する場合は 127.0.0.1 ではなく、開発 PC の LAN 内 IP アドレスにする
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# お問い合わせ先（設定画面に表示）
EXPO_PUBLIC_SUPPORT_EMAIL=

# 広告（未設定・開発中は Google のテスト ID を使う）
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
ADMOB_APP_ID_IOS=
ADMOB_APP_ID_ANDROID=

# EAS（`eas init` で得た projectId。プッシュ通知に必要）
EAS_PROJECT_ID=
